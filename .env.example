# ==========================================
# DeepNova AI - Environment Configuration
# ==========================================

# Node & Application Runtime
NODE_ENV=production
PORT=3000

# MinIO / S3 Object Storage Configuration
# Used by /api/video/[filename] route for secure video streaming
MINIO_ENDPOINT=minio.api.thrivexai.cloud
MINIO_SECURE=True
MINIO_PORT=443
MINIO_BUCKET=depnova-ai
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here

# Optional: Direct Host Port Mapping (when running outside Dokploy reverse proxy)
# Defaults to 3005 to avoid collisions with other projects on the same server
FRONTEND_PORT=3005
